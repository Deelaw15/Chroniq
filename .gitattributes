# Normalize line endings so builds work regardless of the contributor's
# git config (core.autocrlf).

* text=auto

# Shell scripts MUST be LF - a CRLF shebang breaks them on macOS/Linux.
*.sh    text eol=lf
*.command text eol=lf

# Windows batch / PowerShell want CRLF.
*.bat   text eol=crlf
*.ps1   text eol=crlf
*.iss   text eol=crlf

# Treat these as binary (never touch line endings, no diff).
*.png   binary
*.ico   binary
*.icns  binary
*.pyz   binary
*.db    binary
*.exe   binary
*.dmg   binary
